class CvCamera:
    """A real webcam, read through OpenCV (pip install opencv-python)."""

    def __init__(self, index):
        import cv2                                   # ImportError here = OpenCV is not installed
        self.cv2 = cv2
        backend = cv2.CAP_DSHOW if os.name == "nt" else 0      # DirectShow opens faster on Windows
        self.cap = cv2.VideoCapture(index, backend)
        if not self.cap.isOpened():
            raise RuntimeError("cannot open camera %d" % index)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    def read(self):
        from PIL import Image
        ok, frame = self.cap.read()
        if not ok:
            return None
        return Image.fromarray(self.cv2.cvtColor(frame, self.cv2.COLOR_BGR2RGB))

    def release(self):
        self.cap.release()


class DemoCamera:
    """No webcam? This fake camera shows a red 'sign' moving left and right, 30 pictures per second."""

    def __init__(self):
        self.t = 0
        self.next_time = time.time()

    def read(self):
        from PIL import Image, ImageDraw
        wait = self.next_time - time.time()
        if wait > 0:
            time.sleep(wait)                          # keep to about 30 pictures per second
        self.next_time = time.time() + 1 / 30
        self.t += 1
        img = Image.new("RGB", (640, 480), (90, 90, 90))
        d = ImageDraw.Draw(img)
        cx = 320 + int(80 * math.sin(self.t / 15))
        d.ellipse([cx - 110, 130, cx + 110, 350], fill=(200, 0, 0))
        d.rectangle([cx - 70, 222, cx + 70, 258], fill="white")
        return img

    def release(self):
        pass


