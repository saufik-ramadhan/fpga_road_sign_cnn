    # ------------------------------------------------------------------
    # small helpers
    # ------------------------------------------------------------------
    def log(self, text):
        self.log_box.config(state="normal")
        self.log_box.insert("end", time.strftime("%H:%M:%S  ") + text + "\n")
        self.log_box.see("end")
        self.log_box.config(state="disabled")

    def set_buttons(self):
        """Enable only the buttons that make sense right now."""
        connected = self.link is not None
        live = self.mode.get() == "live"
        camera_on = self.cam is not None                                       # NEW (camera)
        sending = self.busy and not live                                       # NEW (camera)
        can_send = connected and self.pixels is not None and not self.busy and live
        state = lambda ok: "normal" if ok else "disabled"
        self.send_btn.config(state=state(can_send))
        self.run_btn.config(state=state(can_send))
        self.stop_btn.config(state=state(self.busy))
        self.open_btn.config(state=state(not self.busy))
        self.roi_entry.config(state=state(not self.busy))
        self.prepared_check.config(state=state(not self.busy))
        self.prepare_btn.config(state=state(not self.busy and self.picture_path is not None))
        self.connect_btn.config(text="Disconnect" if connected else "Connect",
                                state=state(not self.busy))
        for radio in self.mode_radios:
            radio.config(state=state(not self.busy))
        self.cam_btn.config(text="Stop camera" if camera_on else "Start camera",   # NEW (camera) block
                            state=state(not self.busy))
        self.cam_box.config(state="disabled" if camera_on else "readonly")
        self.cam_send_btn.config(text="Stop sending" if sending else "Start sending",
                                 state=state(sending or (connected and camera_on and not self.busy)))

    def refresh_ports(self):
        ports = [DEMO]
        try:
            from serial.tools import list_ports
            ports += [p.device for p in list_ports.comports()]
        except ImportError:
            pass
        self.port_box["values"] = ports
        if not self.port_box.get():
            self.port_box.set(ports[-1])        # last one = most likely the board

    # ------------------------------------------------------------------
    # buttons
    # ------------------------------------------------------------------
    def toggle_connect(self):
        if self.link is not None:                       # disconnect
            self.link.close()
            self.link = None
            self.conn_label.config(text="not connected", foreground="gray")
            self.log("disconnected")
        else:                                           # connect
            port = self.port_box.get()
            try:
                if port == DEMO:
                    self.link = tsr_link.TsrLink(tsr_link.FakeBoard(delay=0.03))
                else:
                    self.link = tsr_link.TsrLink(port)
            except Exception as e:
                messagebox.showerror("Cannot open port", str(e))
                return
            self.conn_label.config(text="connected to " + port, foreground="green")
            self.log("connected to " + port)
        self.set_buttons()

    def open_picture(self):
        path = filedialog.askopenfilename(
            title="Choose a picture",
            filetypes=[("Pictures", "*.png *.jpg *.jpeg *.bmp"), ("All files", "*.*")])
        if not path:
            return
        self.picture_path = path
        self.prepare_picture()

    def invalidate_picture(self, *_):
        """Never send old bytes after the user changes crop/preparation options."""
        self.pixels = None
        self.refresh_preview()
        self.set_buttons()

    def prepare_picture(self):
        self.pixels = None
        try:
            roi = tsr_link.parse_roi(self.roi_text.get())
            self.pixels = tsr_link.load_picture(self.picture_path, roi, self.prepared_input.get())
        except Exception as e:
            self.refresh_preview()
            self.set_buttons()
            messagebox.showerror("Cannot open picture", str(e))
            return
        self.refresh_preview()
        mode = "prepared input" if self.prepared_input.get() else "document-v2"
        self.log("picture: %s (%s, ROI %s)" %
                 (os.path.basename(self.picture_path), mode, roi or "whole image"))
        self.set_buttons()

    # ---- mode switch ----
    def apply_mode(self):
        """Show the buttons and texts that belong to the chosen mode."""
        live = self.mode.get() == "live"
        self.live_controls.pack_forget()
        self.camera_controls.pack_forget()
        (self.live_controls if live else self.camera_controls).pack(fill="x")
        if live:
            self.stop_camera()                          # leaving camera mode: free the webcam
        self.clear_answer()
        self.refresh_preview()
        self.set_buttons()

    def clear_answer(self):
        self.last_result = None
        self.cam_text = ""
        self.sign_label.config(text="-", fg="black")
        self.info_label.config(text="class: -    display: -    time: -")
        for bar, value in self.bars:
            bar.delete("all")
            value.config(text="")

    def refresh_preview(self):
        """Draw the picture that belongs to the current mode."""
        self.canvas.delete("all")
        size = 16 * self.px
        if self.mode.get() == "live":
            self.canvas.config(height=size)                                     # CHANGED (camera): square again
            self.pic_frame.config(text="Picture sent (16 x 16 gray)")
            if self.pixels is not None:
                self.draw_pixels(self.pixels)
            return
        self.pic_frame.config(text="Camera  (green square = part that is sent)")      # NEW (camera) block
        if self.cam is None:
            self.canvas.config(height=size * 3 // 4)                            # a 4:3 camera picture is 3/4 as high
            self.canvas.create_text(size // 2, size * 3 // 8, justify="center", fill="#555555",
                                    text="Camera off\n\nPress 'Start camera'")
        else:
            self.cam_drawn = 0                          # draw the next camera picture again

    def draw_pixels(self, pixels):
        self.canvas.delete("all")
        for i, value in enumerate(pixels):
            x, y = (i % 16) * self.px, (i // 16) * self.px
            color = "#%02x%02x%02x" % (value, value, value)
            self.canvas.create_rectangle(x, y, x + self.px, y + self.px, fill=color, outline=color)

    # ------------------------------------------------------------------
    # CAMERA                                                     # NEW (camera) block
    # Two helper threads:  camera_loop   gets pictures and makes the 16 x 16 gray bytes
    #                      camera_send_worker   sends the newest bytes to the board
    # The window only draws the preview (every 40 ms).
    # ------------------------------------------------------------------
    def on_crop_change(self, *args):
        try:
            self.crop_int = min(100, max(20, int(self.crop_pct.get())))
        except ValueError:
            pass

    def crop_box(self, size):
        """The green square: centred, `crop_int` % of the short side. Returns (x1, y1, x2, y2)."""
        w, h = size
        side = max(16, int(min(w, h) * self.crop_int / 100))
        x1, y1 = (w - side) // 2, (h - side) // 2
        return (x1, y1, x1 + side, y1 + side)

    def toggle_camera(self):
        if self.cam is not None:
            self.stop_camera()
            return
        choice = self.cam_source.get()
        try:
            self.cam = DemoCamera() if choice == DEMO_CAMERA else CvCamera(int(choice.split()[-1]))
        except ImportError:
            messagebox.showerror("Camera", "OpenCV is not installed.\nInstall it with:\n\n"
                                           "    pip install opencv-python\n\n"
                                           "(or choose 'Demo camera' to try the window)")
            return
        except Exception as e:
            messagebox.showerror("Cannot open camera",
                                 "%s\n\nCheck: another program is using the camera, "
                                 "or try Camera 1 / Camera 2.\nWindows: Settings > Privacy > Camera "
                                 "must allow desktop apps." % e)
            return
        self.cam_latest = None
        self.cam_id = 0
        self.cam_drawn = 0
        self.cam_running = True
        self.cam_thread = threading.Thread(target=self.camera_loop, daemon=True)
        self.cam_thread.start()
        self.log("camera started: " + choice)
        self.cam_job = self.root.after(40, self.update_camera_preview)
        self.set_buttons()

    def stop_camera(self):
        if self.cam is None:
            return
        self.stop_flag = True                           # also ends sending, if it runs
        self.cam_running = False
        if self.cam_thread is not None:
            self.cam_thread.join(timeout=1.0)
            self.cam_thread = None
        if self.cam_job is not None:
            self.root.after_cancel(self.cam_job)
            self.cam_job = None
        self.cam.release()
        self.cam = None
        self.cam_latest = None
        try:
            os.remove(self.cam_tmp)
        except OSError:
            pass
        self.log("camera stopped")
        self.refresh_preview()
        self.set_buttons()

    def camera_loop(self):
        """Thread: take a picture, crop the green square, make the 16 x 16 gray bytes."""
        while self.cam_running:
            try:
                frame = self.cam.read()
                if frame is None:
                    time.sleep(0.01)
                    continue
                box = self.crop_box(frame.size)
                # Same function as for picture files, so the preparation is identical.
                frame.crop(box).save(self.cam_tmp, "BMP")
                pixels = tsr_link.load_picture(self.cam_tmp, None, False)
            except Exception as e:
                self.results.put(("camera_error", str(e)))
                return
            self.cam_capture_times.append(time.time())
            with self.cam_lock:
                self.cam_id += 1
                self.cam_latest = (self.cam_id, frame, box, pixels)

    def toggle_sending(self):
        if self.busy:                                   # "Stop sending"
            self.stop_flag = True
            return
        self.busy = True
        self.stop_flag = False
        self.run_count = 0                              # 0 = continuous: no log line for every picture
        self.cam_times.clear()
        self.set_buttons()
        self.log("sending camera pictures...")
        threading.Thread(target=self.camera_send_worker, daemon=True).start()

    def camera_send_worker(self):
        """Thread: send the newest camera picture, wait for the answer, repeat."""
        run_start = time.time()
        done = 0
        last_id = 0
        while not self.stop_flag:
            with self.cam_lock:
                latest = self.cam_latest
            if latest is None or latest[0] == last_id:   # no new picture yet
                time.sleep(0.002)
                continue
            last_id, _frame, _box, pixels = latest
            start = time.time()
            try:
                result, error = self.link.classify(pixels), None
            except Exception as e:
                result, error = None, e
            round_trip_ms = (time.time() - start) * 1000
            self.results.put(("answer", result, error, round_trip_ms))
            done += 1
            if error is not None:
                break                                   # stop at the first problem
        self.results.put(("run_done", done, time.time() - run_start))

    def update_camera_preview(self):
        """Every 40 ms: draw the newest camera picture (only if it is a new one)."""
        if self.cam is None:
            return
        with self.cam_lock:
            latest = self.cam_latest
        if self.mode.get() == "camera" and latest is not None and latest[0] != self.cam_drawn:
            self.cam_drawn = latest[0]
            self.draw_camera(latest)
        self.cam_tick += 1
        if self.cam_tick % 12 == 0:                     # about twice a second
            self.update_camera_fps()
        self.cam_job = self.root.after(40, self.update_camera_preview)

    def draw_camera(self, latest):
        from PIL import Image, ImageTk
        _id, frame, box, pixels = latest
        size = 16 * self.px
        scale = size / frame.width
        view = frame.resize((size, max(1, int(frame.height * scale))))
        if int(self.canvas.cget("height")) != view.height:
            self.canvas.config(height=view.height)      # canvas is exactly as tall as the camera picture
        self.cam_photo = ImageTk.PhotoImage(view)
        self.canvas.delete("all")
        self.canvas.create_image(0, 0, anchor="nw", image=self.cam_photo)
        # green square = the part that is sent
        self.canvas.create_rectangle(box[0] * scale, box[1] * scale, box[2] * scale, box[3] * scale,
                                     outline="#00ff00", width=2)
        # small inset in the corner = the 16 x 16 gray picture the board really gets
        inset = 4 * self.px
        small = Image.frombytes("L", (16, 16), bytes(pixels)).resize((inset, inset), Image.NEAREST)
        self.cam_inset = ImageTk.PhotoImage(small)
        self.canvas.create_rectangle(size - inset - 3, view.height - inset - 3, size - 1, view.height - 1,
                                     fill="white", outline="white")
        self.canvas.create_image(size - inset - 1, view.height - inset - 1, anchor="nw", image=self.cam_inset)
        if self.cam_text:
            self.canvas.create_text(6, 4, anchor="nw", text=self.cam_text, fill="#00ff00",
                                    font=("Arial", int(14 * self.fs), "bold"))

    def update_camera_fps(self):
        """Pictures per second in the last 2 seconds: sent to the board, and taken by the camera."""
        now = time.time()

        def rate(times):
            recent = [t for t in list(times) if now - t <= 2.0]
            if len(recent) < 2 or recent[-1] <= recent[0]:
                return 0.0
            return (len(recent) - 1) / (recent[-1] - recent[0])

        sent, captured = rate(self.cam_times), rate(self.cam_capture_times)
        if sent == 0 and captured == 0:
            self.stat["cam_fps"].set("-   (cable max %.1f)" % LINK_MAX_FPS)
        else:
            self.stat["cam_fps"].set("%.1f sent   (camera %.1f, cable max %.1f)" %
                                     (sent, captured, LINK_MAX_FPS))

    def close(self):
        """Window closed: stop the threads and give the webcam back."""
        self.stop_flag = True
        self.stop_camera()
        self.root.destroy()

    def send_many(self):
        try:
            count = max(2, int(self.count_var.get()))
        except ValueError:
            messagebox.showerror("Send N times", "N must be a whole number")
            return
        self.start_run(count)

    def stop(self):
        self.stop_flag = True

    def reset_stats(self):
        self.history = []
        self.sent = 0
        self.errors = 0
        self.last_run = "-"
        self.cam_times.clear()                                                  # NEW (camera)
        self.update_stats()
        self.log("statistics reset")

    def export_csv(self):
        if not self.history:
            messagebox.showinfo("Export", "No results yet.")
            return
        path = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("CSV", "*.csv")])
        if not path:
            return
        with open(path, "w", newline="") as f:
            w = csv.writer(f)
            w.writerow(["no", "time", "class", "sign", "cnn_cycles", "cnn_us", "round_trip_ms"])
            for n, h in enumerate(self.history, 1):
                w.writerow([n, h["time"], h["class"], SIGN_NAMES[h["class"]],
                            h["cycles"], "%.2f" % h["us"], "%.1f" % h["rt_ms"]])
        self.log("saved %d results to %s" % (len(self.history), path))

    # ------------------------------------------------------------------
    # sending (in a background thread, so the window does not freeze)
    # ------------------------------------------------------------------
    def start_run(self, count):
        self.busy = True
        self.stop_flag = False
        self.run_count = count
        self.set_buttons()
        if count == 1:
            self.log("sending 259 bytes...")
        else:
            self.log("sending the picture %d times..." % count)
        threading.Thread(target=self.run_worker, args=(count,), daemon=True).start()

    def run_worker(self, count):
        run_start = time.time()
        done = 0
        for _ in range(count):
            if self.stop_flag:
                break
            start = time.time()
            try:
                result, error = self.link.classify(self.pixels), None
            except Exception as e:
                result, error = None, e
            round_trip_ms = (time.time() - start) * 1000
            self.results.put(("answer", result, error, round_trip_ms))
            done += 1
            if error is not None:
                break                                   # stop at the first problem
        self.results.put(("run_done", done, time.time() - run_start))

    def check_results(self):
        """Runs every 50 ms in the window thread: handle everything the worker has sent."""
        try:
            while True:
                message = self.results.get_nowait()
                if message[0] == "answer":
                    self.handle_answer(*message[1:])
                elif message[0] == "camera_error":                              # NEW (camera)
                    self.show_error("camera: " + message[1])
                    self.stop_camera()
                else:
                    self.handle_run_done(*message[1:])
        except queue.Empty:
            pass
        self.root.after(50, self.check_results)

    def handle_answer(self, result, error, round_trip_ms):
        self.sent += 1
        if error is not None:
            self.errors += 1
            self.show_error(str(error))
        elif result["status"] != 0:
            self.errors += 1
            self.show_error("board says: " + result["status_text"])
        else:
            self.history.append({"time": time.strftime("%H:%M:%S"), "class": result["class"],
                                 "cycles": result["cycles"], "us": result["time_us"],
                                 "rt_ms": round_trip_ms})
            self.cam_times.append(time.time())                                  # NEW (camera): for the FPS
            self.show_result(result)
            if self.run_count == 1:
                self.log("answer: %s (class %d), CNN %.1f us, round trip %.0f ms" %
                         (SIGN_NAMES[result["class"]], result["class"], result["time_us"],
                          round_trip_ms))
        self.update_stats()

    def handle_run_done(self, done, seconds):
        self.busy = False
        self.set_buttons()
        if self.run_count != 1 and done > 1 and seconds > 0:                    # CHANGED (camera): was "> 1"
            fps = done / seconds
            self.last_run = "%.1f   (%d pictures in %.2f s)" % (fps, done, seconds)
            self.log("run finished: %d pictures in %.2f s = %.1f FPS" % (done, seconds, fps))
            self.update_stats()

    # ------------------------------------------------------------------
    # showing the answer
    # ------------------------------------------------------------------
    def show_error(self, text):
        self.sign_label.config(text="ERROR", fg="red")
        self.info_label.config(text=text)
        self.log("error: " + text)

    def show_result(self, r):
        self.sign_label.config(text=SIGN_NAMES[r["class"]], fg="black")
        self.info_label.config(text="class: %d    display: %s    CNN time: %.1f us" %
                               (r["class"], tsr_link.CLASS_NAMES[r["class"]], r["time_us"]))
        self.cam_text = "%s (class %d)" % (SIGN_NAMES[r["class"]], r["class"])  # NEW (camera): shown on the preview
        self.last_result = (r["scores"], r["class"])
        self.draw_bars()

    def draw_bars(self, event=None):
        """Draw the 8 score bars as wide as the window allows."""
        if self.last_result is None:
            return
        scores, winner = self.last_result
        low, high = min(scores), max(scores)
        span = (high - low) or 1                        # avoid dividing by zero
        for k, (bar, value) in enumerate(self.bars):
            width, height = max(bar.winfo_width() - 2, 10), max(bar.winfo_height(), 10)
            length = int(width * (scores[k] - low) / span)
            bar.delete("all")
            bar.create_rectangle(0, 0, length, height, outline="",
                                 fill="#2e8b57" if k == winner else "#9db7d5")
            value.config(text=str(scores[k]))

    # ------------------------------------------------------------------
    # statistics
    # ------------------------------------------------------------------
    def update_stats(self):
        s = self.stat
        h = self.history
        s["pictures"].set("sent %d     ok %d     errors %d" % (self.sent, len(h), self.errors))
        s["run_fps"].set(self.last_run)
        self.update_camera_fps()                                                # NEW (camera)

        # ---- speed ----
        if h:
            cnn_us = [x["us"] for x in h]
            rt_ms = [x["rt_ms"] for x in h]
            avg_us = sum(cnn_us) / len(cnn_us)
            avg_rt = max(sum(rt_ms) / len(rt_ms), 0.001)

            s["fps"].set("%.1f   (1 / average round trip)" % (1000 / avg_rt))
            s["cnn_fps"].set("%.0f   (1 / average CNN latency)" % (1e6 / max(avg_us, 0.001)))
            kbps = BYTES_PER_PICTURE * 8 / avg_rt                   # bits per ms = kbit/s
            s["bitrate"].set("%s   (cable limit %s)" % (fmt_rate(kbps), fmt_rate(LINK_MAX_KBPS)))
            s["cnn_lat"].set("last %.1f   avg %.1f   min %.1f   max %.1f  us" %
                             (cnn_us[-1], avg_us, min(cnn_us), max(cnn_us)))
            s["round_trip"].set("last %.0f   avg %.0f   min %.0f   max %.0f  ms" %
                                (rt_ms[-1], avg_rt, min(rt_ms), max(rt_ms)))
        else:
            avg_us = None
            for name in ("fps", "cnn_fps", "bitrate", "cnn_lat", "round_trip"):
                s[name].set("-")

        # ---- resources: percent of the chip ----
        for key in ("lut", "bram", "dsp"):
            used = self.number(key)
            s[key + "_pct"].set("" if used is None else "= %.1f %%" % (100 * used / TOTALS[key]))

        # ---- MAC rate: MACs per picture / CNN time ----
        macs = self.number("macs_per_picture")
        s["mac_rate"].set(fmt_macs(macs * 1e6 / avg_us) if macs and avg_us else "-")

        # ---- energy: active power x CNN time ----
        active = self.number("active_w")
        if active is not None and avg_us:
            s["energy"].set("%.4f mJ   (active power x CNN latency)" % (active * avg_us / 1000))
        else:
            s["energy"].set("-")


def main():
    root = tk.Tk()
    app = Hmi(root)
    root.protocol("WM_DELETE_WINDOW", app.close)       # NEW (camera): give the webcam back when the window closes
    root.mainloop()


if __name__ == "__main__":
    main()