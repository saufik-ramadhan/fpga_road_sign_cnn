def fmt_rate(kbps):
    return "%.2f Mbps" % (kbps / 1000) if kbps >= 1000 else "%.1f kbps" % kbps


def fmt_macs(per_second):
    if per_second >= 1e9:
        return "%.2f GMAC/s" % (per_second / 1e9)
    return "%.1f MMAC/s" % (per_second / 1e6)


