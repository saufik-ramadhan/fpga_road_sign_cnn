        self.crop_int = 60                            # same number, safe to read from other threads
        self.cam_lock = threading.Lock()
        self.cam_latest = None                        # (frame number, camera picture, crop box, 256 pixels)
        self.cam_id = 0
        self.cam_drawn = 0                            # number of the frame that is drawn on the screen
        self.cam_running = False
        self.cam_thread = None
        self.cam_job = None                           # the repeating "draw preview" timer
        self.cam_tick = 0
        self.cam_photo = None                         # keep references or the preview disappears
        self.cam_inset = None
        self.cam_text = ""                            # last answer, written on the preview
        self.cam_tmp = os.path.join(tempfile.gettempdir(), "hmi_cam_frame_%d.bmp" % os.getpid())
        self.cam_times = deque(maxlen=300)            # when answers arrived (for FPS)
        self.cam_capture_times = deque(maxlen=300)    # when the camera gave a picture (for FPS)
        self.crop_pct.trace_add("write", self.on_crop_change)

